{
  "manifest_version": 3,
  "name": "Pomodoro — Visual Bar Timer",
  "version": "1.0.0",
  "description": "トマトと目盛りバーで、集中と休憩の時間を見える化。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "notifications"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Pomodoro",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/tomato-16.png", "32": "icons/tomato-32.png", "48": "icons/tomato-48.png", "128": "icons/tomato-128.png" }
  },
  "icons": { "16": "icons/tomato-16.png", "32": "icons/tomato-32.png", "48": "icons/tomato-48.png", "128": "icons/tomato-128.png" }
}
