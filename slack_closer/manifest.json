{
  "manifest_version": 3,
  "name": "Slack Closer",
  "version": "1.0.0",
  "description": "Closes a tab when it hands off a link to the Slack desktop app.",
  "permissions": ["storage", "webNavigation"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Slack Closer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/slack-closer-16.png",
      "32": "assets/slack-closer-32.png",
      "48": "assets/slack-closer-48.png",
      "128": "assets/slack-closer-128.png"
    }
  },
  "icons": {
    "16": "assets/slack-closer-16.png",
    "32": "assets/slack-closer-32.png",
    "48": "assets/slack-closer-48.png",
    "128": "assets/slack-closer-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.slack.com/*", "https://slack.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
